# 운영 서버(EC2)용 환경변수 템플릿. 서버에서 아래 순서로 복사한다 (umask로 생성 시점부터 소유자만 읽게 함):
#   umask 077 && cp .env.prod.example .env && chmod 600 .env
# .env는 .gitignore 대상이라 커밋되지 않는다. 절대 저장소·채팅에 실제 값을 올리지 않는다.
# 값에 $, 공백, #이 들어가면 작은따옴표로 감싼다 (예: DB_PASSWORD='ab$cd#ef') — 그렇지 않으면
# Compose가 $뒤를 변수로 해석해 빈 값으로 치환하거나, #뒤를 주석으로 잘라낼 수 있다.

# --- nginx / TLS ---
APP_DOMAIN=
APP_CERT_EMAIL=
# 아래 둘은 기본값(172.28.0.0/24 · 172.28.0.10)을 그대로 두면 된다. 단, RDS·Redis·VPC 대역과
# 겹치면 app 컨테이너가 외부 대신 이 compose 네트워크로 라우팅해 접속이 끊기므로, 그때만 겹치지
# 않는 값으로 바꾼다 (바꾸면 application-prod.yml의 internal-proxies도 APP_NGINX_INTERNAL_IP와 맞춰야 함).
APP_COMPOSE_SUBNET=172.28.0.0/24
APP_NGINX_INTERNAL_IP=172.28.0.10
# 위 APP_NGINX_INTERNAL_IP를 바꿀 때만 같이 바꾼다. application-prod.yml이 신뢰할 nginx IP를
# 정규식으로 받는 값이라 점(.)을 \.으로 이스케이프해야 한다 (기본값은 그대로 둬도 됨).
APP_NGINX_INTERNAL_IP_REGEX=172\.28\.0\.10

# --- DB (RDS) ---
DB_HOST=
DB_NAME=cramit
DB_PASSWORD=
DB_PORT=5432
DB_USERNAME=

# --- Redis ---
# docker-compose.prod.yml이 redis 컨테이너를 같이 띄우고 REDIS_HOST=redis로 강제 지정하므로
# 이 두 줄은 건드릴 필요 없다. 컨테이너에 비밀번호를 안 걸어뒀으니 REDIS_PASSWORD도 비워 둔다.
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=

# --- FE 연동 ---
FRONTEND_ORIGIN=
FRONTEND_OAUTH_SUCCESS_REDIRECT_URI=
FRONTEND_OAUTH_FAILURE_REDIRECT_URI=

# --- OAuth2 ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- AI / STT ---
GEMINI_API_KEY=
GROQ_API_KEY=
# docker-compose.prod.yml이 ./secrets/gcp-stt.json을 이 경로로 마운트한다
GOOGLE_STT_CREDENTIALS_PATH=/app/secrets/gcp-stt.json

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BASE_URL=
